{
    "id": "ntfyCenter",
    "name": "ntfy Center",
    "description": "Receive ntfy notifications and publish messages from DankMaterialShell",
    "version": "1.3.0",
    "author": "gmaaa",
    "type": "composite",
    "icon": "notifications_active",
    "capabilities": [
        "daemon",
        "dankbar-widget",
        "command-execution",
        "network"
    ],
    "components": {
        "daemon": "./NtfyDaemon.qml",
        "widget": "./NtfyWidget.qml"
    },
    "settings": "./NtfySettings.qml",
    "settings_schema": {
        "subscriptions": {
            "type": "array",
            "default": []
        },
        "showNotifications": {
            "type": "boolean",
            "default": true
        },
        "historyLimit": {
            "type": "integer",
            "default": 20,
            "minimum": 5,
            "maximum": 50
        },
        "historyHours": {
            "type": "integer",
            "default": 24,
            "minimum": 1,
            "maximum": 168
        },
        "publishTitle": {
            "type": "string",
            "default": "From Linux"
        }
    },
    "requires_dms": ">=1.5.0",
    "permissions": [
        "settings_read",
        "settings_write",
        "network",
        "command_execution"
    ]
}